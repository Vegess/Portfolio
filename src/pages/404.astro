---
import Base from "../layouts/Base.astro";
import { PROJECTS } from "../data/projects";
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="notfound wrap" aria-labelledby="nf">
    <p class="eyebrow">404 · not found</p>
    <h1 id="nf">Nothing here.</h1>
    <p class="lede">The page you asked for doesn't exist, or has moved. Try one of these:</p>
    <div class="p-links">
      <a class="btn primary" href="/">Home</a>
      {PROJECTS.map((p) => <a class="btn" href={`/projects/${p.slug}/`}>{p.name}</a>)}
    </div>
  </section>
</Base>

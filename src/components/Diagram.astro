---
/*
 * Hand-written SVG architecture diagram. Edges are routed from the node boxes
 * (straight when aligned, otherwise an elbow through the gap between rows), draw
 * themselves in with stroke-dashoffset when the diagram scrolls into view, then carry
 * a slow "packet" flow that pauses off-screen. Reduced motion: final state, no flow.
 */
import type { DiagramSpec, DNode } from "../data/projects";

interface Props { spec: DiagramSpec; accent: string; compact?: boolean; uid: string }
const { spec, accent, compact = false, uid } = Astro.props;

const H = (n: DNode) => n.h ?? (n.sub ? 50 : 40);
const W = (n: DNode) => n.w ?? 120;
const byId = Object.fromEntries(spec.nodes.map((n) => [n.id, n]));

function route(a: DNode, b: DNode) {
  const [ax, ay, aw, ah] = [a.x, a.y, W(a), H(a)];
  const [bx, by, bw, bh] = [b.x, b.y, W(b), H(b)];
  const acx = ax + aw / 2, acy = ay + ah / 2, bcx = bx + bw / 2, bcy = by + bh / 2;
  if (Math.abs(acy - bcy) < 8) {
    return bcx > acx ? `M${ax + aw} ${acy} H${bx}` : `M${ax} ${acy} H${bx + bw}`;
  }
  const below = by > ay + ah;
  const lo = Math.max(ax, bx), hi = Math.min(ax + aw, bx + bw);
  if (hi - lo > 24) {
    const x = (lo + hi) / 2;
    return below ? `M${x} ${ay + ah} V${by}` : `M${x} ${ay} V${by + bh}`;
  }
  if (below) {
    const mid = (ay + ah + by) / 2;
    return `M${acx} ${ay + ah} V${mid} H${bcx} V${by}`;
  }
  const mid = (by + bh + ay) / 2;
  return `M${acx} ${ay} V${mid} H${bcx} V${by + bh}`;
}

const edges = spec.edges.map(([f, t, o], i) => ({ d: route(byId[f], byId[t]), dashed: !!o?.dashed, i }));
// Monospace subtitles: if the estimated width would overflow the box, squeeze it to fit.
const fit = (t: string, w: number, charW: number) =>
  t.length * charW > w - 14 ? { textLength: w - 14, lengthAdjust: "spacingAndGlyphs" } : {};
const desc = spec.edges.map(([f, t, o]) => `${byId[f].label} → ${byId[t].label}${o?.dashed ? " (fallback or read path)" : ""}`).join("; ");
---
<svg
  class:list={["diagram", { compact }]}
  viewBox={`0 0 ${spec.w} ${spec.h}`}
  role="img"
  aria-labelledby={`${uid}-t ${uid}-d`}
  style={`--accent:${accent}`}
  data-diagram
>
  <title id={`${uid}-t`}>{spec.title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>
  <g class="edges">
    {edges.map((e) => (
      <g style={`--i:${e.i}`}>
        <path class:list={["edge", { dashed: e.dashed }]} d={e.d} pathLength="1" />
        {!e.dashed && <path class="flow" d={e.d} pathLength="1" />}
      </g>
    ))}
  </g>
  <g class="nodes">
    {spec.nodes.map((n, i) => (
      <g class:list={["node", n.tone]} style={`--i:${i}`}>
        <rect x={n.x} y={n.y} width={W(n)} height={H(n)} rx="8" />
        <text x={n.x + W(n) / 2} y={n.y + (n.sub ? 21 : H(n) / 2 + 4.5)} text-anchor="middle" class="nl">{n.label}</text>
        {n.sub && <text x={n.x + W(n) / 2} y={n.y + 38} text-anchor="middle" class="ns" {...fit(n.sub, W(n), compact ? 7 : 6.4)}>{n.sub}</text>}
      </g>
    ))}
  </g>
</svg>

---
import "../styles/global.css";
import { SITE } from "../data/site";
import LinkOrTodo from "../components/LinkOrTodo.astro";
interface Props { title?: string; description?: string; accent?: string }
const { title, description = SITE.description, accent } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}, ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0c10" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="K Anirudh, AI engineer building RAG products and the agents that keep them running." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <nav class="wrap nav" aria-label="Main">
        <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 17 L8 10 L12 14 L16 6 L21 12" class="brand-trace" pathLength="1" /></svg>
          <span>K Anirudh</span>
        </a>
        <ul>
          <li><a href="/#work">Work</a></li>
          <li><a href="/#how">How I build</a></li>
          <li><a href="/#skills">Skills</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot">
        <p>© {new Date().getFullYear()} {SITE.name}. Built with Astro, vanilla CSS and hand-written SVG.</p>
        <p class="foot-links">
          <a href={SITE.github} rel="noopener" target="_blank">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a>
          <LinkOrTodo href={SITE.linkedin} label="LinkedIn" external />
          <LinkOrTodo href={`mailto:${SITE.email}`} todo={SITE.email.startsWith("TODO")} label="Email" />
        </p>
      </div>
    </footer>
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
